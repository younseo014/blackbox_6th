{
  "name": "memory-guard",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "build:win": "npm run build:desktop && electron-builder --win nsis --x64",
    "build:win:dir": "npm run build:desktop && electron-builder --win dir --x64",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:unit",
    "test:unit": "node --import tsx --test tests/motion-analysis.test.ts tests/care-metrics.test.ts tests/demo-personas.test.ts tests/pose-store.test.ts tests/demo-motion.test.ts tests/motion-detection.test.ts tests/motion-segmentation.test.ts tests/observation-engine.test.ts tests/pose-target-lock.test.ts tests/person-presence-gate.test.ts tests/multi-camera.test.ts tests/custom-motion-training.test.ts tests/epfl-posture-classifier.test.ts tests/action-review.test.ts tests/work-context-inference.test.ts tests/global-person-track.test.ts tests/pose-scheduler.test.ts tests/tracking-eval.test.ts tests/pose-model-adapter.test.ts",
    "test:e2e": "npm run build && node tests/e2e/run-personas.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern desktop/dist-desktop --ignore-pattern release --ignore-pattern .next --ignore-pattern public/mediapipe-wasm",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "eval:tracking": "tsx scripts/run-tracking-eval.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@number-flow/react": "^0.6.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.56.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "build": {
    "appId": "kr.memoryguard.desktop",
    "productName": "Memory Guard",
    "asar": true,
    "beforeBuild": "desktop/before-build.cjs",
    "directories": {
      "app": "desktop",
      "output": "release"
    },
    "files": [
      "main.mjs",
      "dist-desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MemoryGuard-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "메모리 가드"
    }
  },
  "type": "module"
}
